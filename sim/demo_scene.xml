<!-- World for the firmware-in-the-loop demonstration (sim/firmware_sim.py).
     The robot starts at the origin facing +x. The DEMO sequence drives 1 m, reverses 0.3 m, turns 90 deg
     left and then drives at this wall, whose face is at y = 1.20 m. -->
<mujoco model="wheeled_humanoid_v2_demo">
  <include file="wheeled_humanoid_v2.xml"/>
  <visual><headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/><global azimuth="150" elevation="-20" offwidth="1280" offheight="720"/><rgba rangefinder="1 1 0 0.35"/></visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.9 0.92 0.95" rgb2="0.6 0.65 0.7" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.83 0.85" rgb2="0.74 0.75 0.78" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
  </asset>
  <worldbody>
    <light pos="1 -1 2.5" dir="-0.4 0.4 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.05" material="grid" friction="1.0 0.01 0.001"/>
    <geom name="demo_wall" type="box" pos="0.7 1.22 0.3" size="0.6 0.02 0.3" rgba="0.75 0.7 0.6 1"/>
  </worldbody>
</mujoco>
