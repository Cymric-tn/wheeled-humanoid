0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b221"><mxGeometry x="0" y="6.0" width="100" height="16" as="geometry"/></mxCell><mxCell id="w224" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=none;startArrow=none;strokeColor=#757575;strokeWidth=3;fontSize=9;fontStyle=1;fontColor=#757575;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p222" target="p223"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="b225" value="&lt;b&gt;XY-3606&lt;/b&gt;&lt;br&gt;5.1 V output (sheet 1)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5F5F5;strokeColor=#424242;strokeWidth=1.5;align=right;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1280" y="943.0" width="230" height="65.0" as="geometry"/></mxCell><mxCell id="p226" value="pins 2, 4 (5V)" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b191"><mxGeometry x="130" y="306.0" width="120" height="16" as="geometry"/></mxCell><mxCell id="p227" value="OUT+" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b225"><mxGeometry x="0" y="22.0" width="100" height="16" as="geometry"/></mxCell><mxCell id="w228" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=none;startArrow=none;strokeColor=#C62828;strokeWidth=1.2;fontSize=9;fontStyle=1;fontColor=#C62828;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p226" target="p227"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="p229" value="pin 6 (GND)" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b191"><mxGeometry x="130" y="324.0" width="120" height="16" as="geometry"/></mxCell><mxCell id="p230" value="OUT−" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b225"><mxGeometry x="0" y="40.0" width="100" height="16" as="geometry"/></mxCell><mxCell id="w231" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=none;startArrow=none;strokeColor=#1A1A1A;strokeWidth=1.2;fontSize=9;fontStyle=1;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p229" target="p230"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="x232" value="Right OLED on a software I²C bus, enabled in &lt;font face=&quot;monospace&quot;&gt;config.txt&lt;/font&gt;:&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;dtoverlay=i2c-gpio,bus=3,i2c_gpio_sda=23,i2c_gpio_scl=24&lt;/font&gt;&lt;br&gt;Pi fan on the FAN header. Both OLEDs are 0x3C, so they need separate buses." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="1029.0" width="560" height="70" as="geometry"/></mxCell><mxCell id="x233" value="&lt;b&gt;I²C bus of the Mega&lt;/b&gt; (D20 SDA, D21 SCL): VL53L0X ×2, MPU-6050, PCA9685. VL53L0X no. 1 is held off with XSHUT at boot and re-addressed to 0x30; no. 2 keeps 0x29. Never drive XSHUT high: drive it low or leave it as an input.&lt;br&gt;The Mega pulls SDA and SCL to 5 V through 10 kΩ; if the bus is unreliable, add a level shifter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="540" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Servo harness" id="sheet3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b&gt;Sheet 3: servo harness&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#AD1457;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="30" as="geometry"/></mxCell><mxCell id="x2" value="PCA9685 signal channels to the servo headers on the perfboard strips. Each header takes its signal from one PCA9685 channel and V+ / GND from its strip. Servo power never passes through the PCA9685." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1594" height="36" as="geometry"/></mxCell><mxCell id="x3" value="Wheeled Humanoid · RAS Build Challenge, Project 2 · rev. 15/11/2026" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=9;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="1224" y="1146" width="400" height="20" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;PCA9685&lt;/b&gt; 16-ch PWM (0x40)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="170" width="250" height="484" as="geometry"/></mxCell><mxCell id="p5" value="PWM 0, signa