eometry x="98" y="496" width="250" height="16" as="geometry"/></mxCell><mxCell id="l134" value="" style="endArrow=none;html=1;strokeColor=#1A1A1A;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="522" as="sourcePoint"/><mxPoint x="90" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x135" value="negative, 14 AWG" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="98" y="514" width="250" height="16" as="geometry"/></mxCell><mxCell id="l136" value="" style="endArrow=none;html=1;strokeColor=#C62828;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="540" as="sourcePoint"/><mxPoint x="90" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x137" value="positive, 16 AWG" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="98" y="532" width="250" height="16" as="geometry"/></mxCell><mxCell id="l138" value="" style="endArrow=none;html=1;strokeColor=#1A1A1A;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="558" as="sourcePoint"/><mxPoint x="90" y="558" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x139" value="negative, 16 AWG" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="98" y="550" width="250" height="16" as="geometry"/></mxCell><mxCell id="l140" value="" style="endArrow=none;html=1;strokeColor=#C62828;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="576" as="sourcePoint"/><mxPoint x="90" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x141" value="26 AWG (divider)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="98" y="568" width="250" height="16" as="geometry"/></mxCell><mxCell id="l142" value="" style="endArrow=none;html=1;strokeColor=#1565C0;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="594" as="sourcePoint"/><mxPoint x="90" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x143" value="signal to the Mega" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="98" y="586" width="250" height="16" as="geometry"/></mxCell><mxCell id="d144" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;points=[[0.5,0.5]];" vertex="1" parent="1"><mxGeometry x="46" y="610" width="8" height="8" as="geometry"/></mxCell><mxCell id="x145" value="soldered splice with heat-shrink" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="62" y="605" width="300" height="18" as="geometry"/></mxCell><mxCell id="x146" value="&lt;b&gt;Order on the positive lead:&lt;/b&gt; battery, XT60, fuse, switch, the two taps before the emergency stop (divider and Pi supply), the emergency stop, then every actuator.&lt;br&gt;The +ACT and GND splices sit at the rear of the upper deck, next to the converters.&lt;br&gt;The converters are not isolated: IN− and OUT− are the same node.&lt;br&gt;The Mega has no power wire here: it is fed by the Pi over USB (sheet 2).&lt;br&gt;&lt;b&gt;Before connecting any load:&lt;/b&gt; set XL4016 A and B to 6.8 V and the XY-3606 to 5.1 V with a multimeter, outputs open." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="500" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Signal wiring" id="sheet2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b&gt;Sheet 2: signal wiring&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#AD1457;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="30" as="geometry"/></mxCell><mxCell id="x2" value="Every module pin to its controller pin. Blue: digital signal. Green: I²C SDA. Orange: I²C SCL. Purple: USB. Red and black tags: 5 V and GND from the Mega (3.3 V and GND from the Pi for the OLEDs)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1594" height="36" as="geometry"/></mxCell><mxCell id="x3" value="Wheeled Humanoid · RAS Build Challenge, Project 2 · rev. 15/11/2026" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=9;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="1224" y="1206" width="400" height="20" as="geometry"/></mxCell><mxCell id="b4" value="Left motor&lt;br&gt;encoder plug" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5F5F5;strokeColor=#424242;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="106" as="geometry"/></mxCell><mxCell id="p5" value="VCC" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b4"><mxGeometry x="160" y="27.0" width="110" height="16" as="geometry"/></mxCell><mxCell id="p6" value="C1 (phase A)" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;spacingLeft=4;spacingRight=4;fontColor=#000000;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];" vertex="1" parent="b4"><mxGeometry x="160" y="45.0" width="110" height="16" 