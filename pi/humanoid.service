# systemd unit: starts the Pi service at boot and restarts it if it stops.
#   sudo cp humanoid.service /etc/systemd/system/ && sudo systemctl enable --now humanoid
[Unit]
Description=Wheeled humanoid Pi service (eyes, camera, web page)
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/humanoid/pi
ExecStart=/home/pi/humanoid/pi/.venv/bin/python -m humanoid_pi --port /dev/ttyACM0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
